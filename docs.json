{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "UncleBBQ Customer Support Base",
  "colors": {
    "primary": "#B82025",
    "light": "#F04444",
    "dark": "#8F171C"
  },
  "favicon": {
    "light": "/images/GlossyRedDocumentStackIcon.png",
    "dark": "/images/GlossyRedDocumentStackIcon.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Customer Service",
        "pages": [
          "customer-service/overview",
          {
            "group": "Pitmaster Rewards",
            "pages": [
              "customer-service/pitmaster-rewards",
              "customer-service/rewards-faq"
            ]
          },
          {
            "group": "Account & Privacy",
            "pages": [
              "customer-service/account-deletion",
              "customer-service/privacy-rights-overview",
              "customer-service/manage-account"
            ]
          },
          {
            "group": "Orders & Refunds",
            "pages": [
              "customer-service/refund-policy"
            ]
          },
          {
            "group": "Ordering",
            "pages": [
              "customer-service/online-ordering",
              "customer-service/delivery-pickup",
              "customer-service/discount-codes"
            ]
          },
          {
            "group": "Catering",
            "pages": [
              "customer-service/catering"
            ]
          },
          {
            "group": "General",
            "pages": [
              "customer-service/contact-hours",
              "customer-service/email-subscriptions"
            ]
          },
          {
            "group": "Menu & Food",
            "pages": [
              "customer-service/allergens-dietary"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/UncleJ’sDirtyApronDocumentationLogo-2.png",
    "dark": "/images/UncleJ’sDirtyApronDocumentationLogo-2.png",
    "href": "https://unclebbq.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Customer Support",
      "href": "https://customerservice.unclebbq.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "perplexity",
      "assistant"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Legal Policies",
        "items": [
          {
            "label": "Terms of Service",
            "href": "https://unclebbq.com/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "https://unclebbq.com/privacy"
          },
          {
            "label": "AI Policy",
            "href": "https://unclebbq.com/ai-policy"
          }
        ]
      }
    ]
  },
  "description": "Uncle J's Dirty Apron BBQ Customer Support Articles",
  "thumbnails": {
    "background": "/images/UncleJ’sDocumentationBBQBanner-1.png"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  }
}
